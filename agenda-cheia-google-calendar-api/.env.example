APP_NAME="Agendacheia Google Calendar API"
GOOGLE_CALENDAR_ID="primary"
GOOGLE_CREDENTIALS_FILE="/absolute/path/to/service-account.json"
# Optional: impersonate a Workspace user when using domain-wide delegation.
# GOOGLE_DELEGATED_SUBJECT="user@your-domain.com"

# OAuth for connecting a real user's Google Calendar.
# Create a Google OAuth client of type "Web application" and configure this
# exact redirect URI in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=""
GOOGLE_OAUTH_REDIRECT_URI="http://127.0.0.1:8001/auth/google/callback"
GOOGLE_OAUTH_SCOPES="openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/calendar.events"
GOOGLE_OAUTH_PROMPT_CONSENT=true

DEFAULT_TIMEZONE="America/Sao_Paulo"
DATABASE_URL="sqlite:///./calendar_sync.db"

# Required only for Google push notifications.
# Must be a public HTTPS base URL, for example from production or ngrok.
# GOOGLE_WEBHOOK_BASE_URL="https://api.example.com"
# GOOGLE_WEBHOOK_TOKEN="replace-with-random-token"
WATCH_TTL_SECONDS=604800
CORS_ALLOWED_ORIGINS="*"

# Optional background polling. Manual polling is always available via POST /sync/poll.
ENABLE_POLLING_ON_STARTUP=false
POLL_INTERVAL_SECONDS=300
