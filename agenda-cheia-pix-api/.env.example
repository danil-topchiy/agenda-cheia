# Woovi AppID. Use the raw value in Authorization, without Bearer.
WOOVI_APP_ID=

# Production: https://api.woovi.com
# Sandbox: https://api.woovi-sandbox.com
WOOVI_API_BASE_URL=https://api.woovi.com

# Local SQLite database path.
DATABASE_PATH=data/agenda_cheia_pix.db

# Optional shared value configured as Authorization header in the Woovi webhook.
WOOVI_WEBHOOK_AUTHORIZATION=

# Recommended for production. Disable only for local manual tests.
WOOVI_WEBHOOK_VERIFY_SIGNATURE=true

# Optional override. If empty, defaults to <WOOVI_API_BASE_URL>/api/v1/webhook/public-keys
WOOVI_WEBHOOK_PUBLIC_KEYS_URL=

WOOVI_REQUEST_TIMEOUT=15
