# Base URL of agenda-cheia-pix-api.
PIX_API_BASE_URL=http://127.0.0.1:8000

# Public URL of this UI when exposed with ngrok/Cloudflare Tunnel.
# Used only to display the webhook URL in the screen.
PUBLIC_BASE_URL=http://127.0.0.1:8010

FORWARD_WEBHOOK_TO_PIX_API=true
REQUEST_TIMEOUT=20
WEBHOOK_EVENT_LIMIT=200

